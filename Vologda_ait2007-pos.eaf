            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>есть разделение на гуманитарное </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220"
                TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts116">
